      "dark": "html[data-theme=\"dark\"] ou prefers-color-scheme: dark sem escolha salva (html[data-theme=\"light\"] força o claro); tokens dark-* no frontmatter; shell, figurinhas, borda de papel, rest e on-rest iguais nos dois temas."
    }
  },
  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Ação principal: bloco em tinta; como link, leva uma seta depois do rótulo.",
      "html": "<a href=\"#\" class=\"ds-btn ds-btn-primary\"><span>Criar primeira atividade</span><svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14\"/><path d=\"m12 5 7 7-7 7\"/></svg></a>",
      "css": ":host{--color-bg:#ffffff;--color-surface:#eef0f6;--color-text:#16181d;--color-text-muted:#50555f;--color-shell:#1b3fbf;--color-on-shell:#ffffff;--color-focus-on-shell:#ffffff;--color-primary:#16181d;--color-on-primary:#ffffff;--color-danger:#b3261e;--color-focus:#16181d;--color-sticker-green:#00a65a;--color-on-sticker:#16181d;--color-sticker-edge:#ffffff;--font-sans:'Barlow',ui-sans-serif,system-ui,sans-serif;--font-display:'Barlow Condensed','Barlow',ui-sans-serif,system-ui,sans-serif;}.ds-btn{font-family:var(--font-sans);display:inline-flex;min-height:2.75rem;min-width:2.75rem;align-items:center;justify-content:center;gap:.5rem;border-radius:.625rem;padding:0 1.25rem;font-weight:700;font-size:1rem;white-space:nowrap;cursor:pointer;border:0;text-decoration:none;transition:transform 150ms;}.ds-btn:active{transform:translateY(1px);}.ds-btn:focus-visible{outline:3px solid var(--color-focus);outline-offset:2px;}.ds-btn:disabled{opacity:.6;cursor:not-allowed;}@media (prefers-reduced-motion:reduce){.ds-btn{transition:none;}}.ds-btn-primary{background:var(--color-primary);color:var(--color-on-primary);}.ds-btn-primary:hover{filter:brightness(.95);}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Ação alternativa: contorno de 2 px em tinta, hover em surface.",
      "html": "<a href=\"#\" class=\"ds-btn ds-btn-secondary\"><span>Usar o passo a passo</span><svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14\"/><path d=\"m12 5 7 7-7 7\"/></svg></a>",
      "css": ":host{--color-bg:#ffffff;--color-surface:#eef0f6;--color-text:#16181d;--color-text-muted:#50555f;--color-shell:#1b3fbf;--color-on-shell:#ffffff;--color-focus-on-shell:#ffffff;--color-primary:#16181d;--color-on-primary:#ffffff;--color-danger:#b3261e;--color-focus:#16181d;--color-sticker-green:#00a65a;--color-on-sticker:#16181d;--color-sticker-edge:#ffffff;--font-sans:'Barlow',ui-sans-serif,system-ui,sans-serif;--font-display:'Barlow Condensed','Barlow',ui-sans-serif,system-ui,sans-serif;}.ds-btn{font-family:var(--font-sans);display:inline-flex;min-height:2.75rem;min-width:2.75rem;align-items:center;justify-content:center;gap:.5rem;border-radius:.625rem;padding:0 1.25rem;font-weight:700;font-size:1rem;white-space:nowrap;cursor:pointer;border:0;text-decoration:none;transition:transform 150ms;}.ds-btn:active{transform:translateY(1px);}.ds-btn:focus-visible{outline:3px solid var(--color-focus);outline-offset:2px;}.ds-btn:disabled{opacity:.6;cursor:not-allowed;}@media (prefers-reduced-motion:reduce){.ds-btn{transition:none;}}.ds-btn-secondary{background:transparent;color:var(--color-text);border:2px solid var(--color-text);}.ds-btn-secondary:hover{background:var(--color-surface);}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Ação de baixo peso (ex.: Agora não no aviso de nova versão).",
      "html": "<button type=\"button\" class=\"ds-btn ds-btn-ghost\">Agora não</button>",
      "css": ":host{--color-bg:#ffffff;--color-surface:#eef0f6;--color-text:#16181d;--color-text-muted:#50555f;--color-shell:#1b3fbf;--color-on-shell:#ffffff;--color-focus-on-shell:#ffffff;--color-primary:#16181d;--color-on-primary:#ffffff;--color-danger:#b3261e;--color-focus:#16181d;--color-sticker-green:#00a65a;--color-on-sticker:#16181d;--color-sticker-edge:#ffffff;--font-sans:'Barlow',ui-sans-serif,system-ui,sans-serif;--font-display:'Barlow Condensed','Barlow',ui-sans-serif,system-ui,sans-serif;}.ds-btn{font-family:var(--font-sans);display:inline-flex;min-height:2.75rem;min-width:2.75rem;align-items:center;justify-content:center;gap:.5rem;border-radius:.625rem;padding:0 1.25rem;font-weight:700;font-size:1rem;white-space:nowrap;cursor:pointer;border:0;text-decoration:none;transition:transform 150ms;}.ds-btn:active{transform:translateY(1px);}.ds-btn:focus-visible{outline:3px solid var(--color-focus);outline-offset:2px;}.ds-btn:disabled{opacity:.6;cursor:not-allowed;}@media (prefers-reduced-motion:reduce){.ds-btn{transition:none;}}.ds-btn-ghost{background:transparent;color:var(--color-text);}.ds-btn-ghost:hover{background:var(--color-surface);}"
    },
    {
      "name": "Danger Button",
      "kind": "button",
      "refersTo": "button-danger",
      "description": "Ação destrutiva: contorno e texto em danger.",
      "html": "<button type=\"button\" class=\"ds-btn ds-btn-danger\">Excluir atividade</button>",
      "css": ":host{--color-bg:#ffffff;--color-surface:#eef0f6;--color-text:#16181d;--color-text-muted:#50555f;--color-shell:#1b3fbf;--color-on-shell:#ffffff;--color-focus-on-shell:#ffffff;--color-primary:#16181d;--color-on-primary:#ffffff;--color-danger:#b3261e;--color-focus:#16181d;--color-sticker-green:#00a65a;--color-on-sticker:#16181d;--color-sticker-edge:#ffffff;--font-sans:'Barlow',ui-sans-serif,system-ui,sans-serif;--font-display:'Barlow Condensed','Barlow',ui-sans-serif,system-ui,sans-serif;}.ds-btn{font-family:var(--font-sans);display:inline-flex;min-height:2.75rem;min-width:2.75rem;align-items:center;justify-content:center;gap:.5rem;border-radius:.625rem;padding:0 1.25rem;font-weight:700;font-size:1rem;white-space:nowrap;cursor:pointer;border:0;text-decoration:none;transition:transform 150ms;}.ds-btn:active{transform:translateY(1px);}.ds-btn:focus-visible{outline:3px solid var(--color-focus);outline-offset:2px;}.ds-btn:disabled{opacity:.6;cursor:not-allowed;}@media (prefers-reduced-motion:reduce){.ds-btn{transition:none;}}.ds-btn-danger{background:transparent;color:var(--color-danger);border:2px solid var(--color-danger);}.ds-btn-danger:hover{background:var(--color-surface);}"
    },
    {
      "name": "Sticker",
      "kind": "custom",
      "refersTo": "sticker",
      "description": "Gesto próprio: vaga tracejada com o número que vai ganhar; colada, figurinha na cor da atividade com borda de papel, torta −2°, que cai em 320 ms.",
      "html": "<div class=\"ds-sticker-row\"><button type=\"button\" aria-pressed=\"false\" aria-label=\"Figurinha nº 1 de Caminhada\" class=\"ds-sticker ds-sticker-slot\"><span class=\"ds-sticker-num-slot\">1</span><span class=\"ds-sticker-label\">colar</span></button><button type=\"button\" aria-pressed=\"true\" aria-label=\"Figurinha nº 1 de Caminhada\" class=\"ds-sticker ds-sticker-done\"><span class=\"ds-sticker-label\">Nº</span><span class=\"ds-sticker-num\">1</span></button></div>",
      "css": ":host{--color-bg:#ffffff;--color-surface:#eef0f6;--color-text:#16181d;--color-text-muted:#50555f;--color-shell:#1b3fbf;--color-on-shell:#ffffff;--color-focus-on-shell:#ffffff;--color-primary:#16181d;--color-on-primary:#ffffff;--color-danger:#b3261e;--color-focus:#16181d;--color-sticker-green:#00a65a;--color-on-sticker:#16181d;--color-sticker-edge:#ffffff;--font-sans:'Barlow',ui-sans-serif,system-ui,sans-serif;--font-display:'Barlow Condensed','Barlow',ui-sans-serif,system-ui,sans-serif;}.ds-sticker-row{display:flex;gap:1rem;align-items:center;}.ds-sticker{font-family:var(--font-sans);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.125rem;width:4rem;height:4.75rem;flex-shrink:0;border-radius:.625rem;cursor:pointer;background:transparent;padding:0;}.ds-sticker:focus-visible{outline:3px solid var(--color-focus);outline-offset:2px;}.ds-sticker-slot{border:2px dashed var(--color-text);color:var(--color-text);}.ds-sticker-slot:hover{background:var(--color-surface);}.ds-sticker-done{background:var(--color-sticker-green);color:var(--color-on-sticker);border:4px solid var(--color-sticker-edge);outline:2px solid var(--color-on-sticker);box-shadow:0 2px 0 rgb(0 0 0 / .25);transform:rotate(-2deg);animation:ds-sticker-in 320ms cubic-bezier(.22,1,.36,1) both;}.ds-sticker-done:focus-visible{outline:3px solid var(--color-focus);}.ds-sticker-num,.ds-sticker-num-slot{font-family:var(--font-display);font-weight:800;line-height:1;text-transform:uppercase;}.ds-sticker-num{font-size:2rem;}.ds-sticker-num-slot{font-size:1.375rem;}.ds-sticker-label{font-size:.8125rem;font-weight:700;line-height:1;}@keyframes ds-sticker-in{0%{transform:translateY(-.5rem) rotate(9deg) scale(1.14);}100%{transform:rotate(-2deg) scale(1);}}@media (prefers-reduced-motion:reduce){.ds-sticker-done{animation:none;}}"
    },
    {
      "name": "Switch",
      "kind": "custom",
      "refersTo": "switch",
      "description": "Interruptor: trilho de 72 × 44 px, azul ligado, ponto de papel atravessando em 250 ms.",
      "html": "<label class=\"ds-switch-row\"><span>Lembretes</span><button type=\"button\" role=\"switch\" aria-checked=\"true\" class=\"ds-switch\"><span class=\"ds-switch-thumb\"></span></button></label>",
      "css": ":host{--color-bg:#ffffff;--color-surface:#eef0f6;--color-text:#16181d;--color-text-muted:#50555f;--color-shell:#1b3fbf;--color-on-shell:#ffffff;--color-focus-on-shell:#ffffff;--color-primary:#16181d;--color-on-primary:#ffffff;--color-danger:#b3261e;--color-focus:#16181d;--color-sticker-green:#00a65a;--color-on-sticker:#16181d;--color-sticker-edge:#ffffff;--font-sans:'Barlow',ui-sans-serif,system-ui,sans-serif;--font-display:'Barlow Condensed','Barlow',ui-sans-serif,system-ui,sans-serif;}.ds-switch-row{font-family:var(--font-sans);font-weight:500;display:flex;min-height:2.75rem;align-items:center;justify-content:space-between;gap:1rem;color:var(--color-text);}.ds-switch{display:inline-flex;align-items:center;width:4.5rem;height:2.75rem;padding:2px;border-radius:9999px;border:2px solid var(--color-text);background:var(--color-surface);cursor:pointer;}.ds-switch[aria-checked=\"true\"]{background:var(--color-shell);}.ds-switch:focus-visible{outline:3px solid var(--color-focus);outline-offset:2px;}.ds-switch-thumb{display:block;width:2.25rem;height:2.25rem;border-radius:9999px;border:2px solid var(--color-text);background:var(--color-sticker-edge);transition:transform 250ms cubic-bezier(.22,1,.36,1);}.ds-switch[aria-checked=\"true\"] .ds-switch-thumb{transform:translateX(1.5rem);border-color:var(--color-on-sticker);}@media (prefers-reduced-motion:reduce){.ds-switch-thumb{transition:none;}}"
    },
    {
      "name": "Tab Navigation",
      "kind": "nav",
      "refersTo": "nav-tab",
      "description": "Navegação de 3 abas (Hoje · Álbum · Ajustes); a ativa é um bloco em tinta.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Principal\"><a href=\"#\" class=\"ds-tab\" aria-current=\"page\"><svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.25\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8\"/><path d=\"M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"/></svg>Hoje</a><a href=\"#\" class=\"ds-tab\"><svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.25\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 7v14\"/><path d=\"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z\"/></svg>Álbum</a><a href=\"#\" class=\"ds-tab\"><svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.25\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41\"/></svg>Ajustes</a></nav>",
      "css": ":host{--color-bg:#ffffff;--color-surface:#eef0f6;--color-text:#16181d;--color-text-muted:#50555f;--color-shell:#1b3fbf;--color-on-shell:#ffffff;--color-focus-on-shell:#ffffff;--color-primary:#16181d;--color-on-primary:#ffffff;--color-danger:#b3261e;--color-focus:#16181d;--color-sticker-green:#00a65a;--color-on-sticker:#16181d;--color-sticker-edge:#ffffff;--font-sans:'Barlow',ui-sans-serif,system-ui,sans-serif;--font-display:'Barlow Condensed','Barlow',ui-sans-serif,system-ui,sans-serif;}.ds-nav{font-family:var(--font-sans);display:grid;grid-template-columns:repeat(3,1fr);gap:.5rem;padding:.5rem .75rem .75rem;background:var(--color-bg);border-top:2px solid var(--color-surface);}.ds-tab{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.125rem;min-height:3.5rem;min-width:2.75rem;border-radius:.625rem;font-size:.8125rem;font-weight:700;color:var(--color-text-muted);text-decoration:none;}.ds-tab:hover{color:var(--color-text);}.ds-tab:focus-visible{outline:3px solid var(--color-focus);outline-offset:2px;}.ds-tab[aria-current=\"page\"]{background:var(--color-primary);color:var(--color-on-primary);}"
    },
    {
      "name": "Band Header",
      "kind": "custom",
      "refersTo": "band-header",
      "description": "Faixa da semana: azul chapado no topo de Hoje e do Álbum, com semana e data, título condensado e frase-resumo.",
      "html": "<header class=\"ds-band\"><p class=\"ds-band-meta\">Semana 43 · domingo, 25 de outubro</p><h1 class=\"ds-band-title\">Hoje</h1><p class=\"ds-band-lead\">Seu dia começa quando você escolher suas atividades.</p></header>",
      "css": ":host{--color-bg:#ffffff;--color-surface:#eef0f6;--color-text:#16181d;--color-text-muted:#50555f;--color-shell:#1b3fbf;--color-on-shell:#ffffff;--color-focus-on-shell:#ffffff;--color-primary:#16181d;--color-on-primary:#ffffff;--color-danger:#b3261e;--color-focus:#16181d;--color-sticker-green:#00a65a;--color-on-sticker:#16181d;--color-sticker-edge:#ffffff;--font-sans:'Barlow',ui-sans-serif,system-ui,sans-serif;--font-display:'Barlow Condensed','Barlow',ui-sans-serif,system-ui,sans-serif;}.ds-band{font-family:var(--font-sans);background:var(--color-shell);color:var(--color-on-shell);padding:1.5rem 1.25rem 1.75rem;}.ds-band :focus-visible{outline:3px solid var(--color-focus-on-shell);outline-offset:2px;}.ds-band-meta{margin:0;font-size:.9375rem;font-weight:700;}.ds-band-title{margin:.5rem 0 0;font-family:var(--font-display);font-weight:800;font-size:4rem;line-height:.95;letter-spacing:-.01em;text-transform:uppercase;}.ds-band-lead{margin:.75rem 0 0;max-width:22rem;font-size:1.125rem;font-weight:700;line-height:1.556;}"
    },
    {
      "name": "Empty State",
      "kind": "custom",
      "refersTo": "empty-state",
      "description": "Estado vazio que ensina o próximo passo: título condensado, texto, peça do mundo (aqui a página vazia do Álbum) e ações.",
      "html": "<section class=\"ds-empty\"><h2 class=\"ds-empty-title\">Semanas e meses</h2><p class=\"ds-empty-body\">Cada semana vira uma página do álbum quando você colar a primeira figurinha.</p><div class=\"ds-page\" aria-hidden=\"true\"><div class=\"ds-slot\">S</div><div class=\"ds-slot\">T</div><div class=\"ds-slot\">Q</div><div class=\"ds-slot\">Q</div><div class=\"ds-slot\">S</div><div class=\"ds-slot\">S</div><div class=\"ds-slot ds-slot-today\">D</div></div></section>",
      "css": ":host{--color-bg:#ffffff;--color-surface:#eef0f6;--color-text:#16181d;--color-text-muted:#50555f;--color-shell:#1b3fbf;--color-on-shell:#ffffff;--color-focus-on-shell:#ffffff;--color-primary:#16181d;--color-on-primary:#ffffff;--color-danger:#b3261e;--color-focus:#16181d;--color-sticker-green:#00a65a;--color-on-sticker:#16181d;--color-sticker-edge:#ffffff;--font-sans:'Barlow',ui-sans-serif,system-ui,sans-serif;--font-display:'Barlow Condensed','Barlow',ui-sans-serif,system-ui,sans-serif;}.ds-empty{font-family:var(--font-sans);font-weight:500;color:var(--color-text);padding:2rem 1.25rem;max-width:42rem;}.ds-empty-title{margin:0;font-family:var(--font-display);font-weight:800;font-size:1.5rem;line-height:1.1;text-transform:uppercase;}.ds-empty-body{margin:.5rem 0 0;max-width:60ch;color:var(--color-text-muted);}.ds-page{margin-top:1.25rem;display:grid;grid-template-columns:repeat(7,1fr);gap:.375rem;}.ds-slot{display:flex;aspect-ratio:4/5;align-items:flex-end;justify-content:center;padding-bottom:.25rem;border:2px dashed #6b7180;border-radius:.625rem;color:var(--color-text-muted);font-size:.875rem;font-weight:700;}.ds-slot-today{border-color:var(--color-text);color:var(--color-text);}"
    },
    {
      "name": "Menu",
      "kind": "custom",
      "refersTo": "menu",
      "description": "Menu de ações suspenso: caixa com contorno de 2 px, canto de camada e sombra Menu.",
      "html": "<div role=\"menu\" class=\"ds-menu\"><div role=\"menuitem\" tabindex=\"0\" class=\"ds-menu-item\">Editar</div><div role=\"menuitem\" tabindex=\"-1\" class=\"ds-menu-item\">Pausar</div><div role=\"menuitem\" tabindex=\"-1\" class=\"ds-menu-item\">Arquivar</div></div>",
      "css": ":host{--color-bg:#ffffff;--color-surface:#eef0f6;--color-text:#16181d;--color-text-muted:#50555f;--color-shell:#1b3fbf;--color-on-shell:#ffffff;--color-focus-on-shell:#ffffff;--color-primary:#16181d;--color-on-primary:#ffffff;--color-danger:#b3261e;--color-focus:#16181d;--color-sticker-green:#00a65a;--color-on-sticker:#16181d;--color-sticker-edge:#ffffff;--font-sans:'Barlow',ui-sans-serif,system-ui,sans-serif;--font-display:'Barlow Condensed','Barlow',ui-sans-serif,system-ui,sans-serif;}.ds-menu{font-family:var(--font-sans);min-width:12rem;background:var(--color-bg);color:var(--color-text);border:2px solid var(--color-text);border-radius:1rem;padding:.375rem;box-shadow:0 10px 24px -10px rgb(0 0 0 / .35);}.ds-menu-item{display:flex;min-height:2.75rem;align-items:center;padding:0 .75rem;border-radius:.375rem;font-weight:700;cursor:pointer;outline:none;}.ds-menu-item:hover,.ds-menu-item:focus-visible{background:var(--color-surface);outline:3px solid var(--color-focus);outline-offset:-3px;}"
    },
    {
      "name": "Dialog",
      "kind": "card",
      "refersTo": "dialog",
      "description": "Diálogo modal: caixa de até 28rem, contorno de 2 px, título condensado e sombra Camada.",
      "html": "<div role=\"dialog\" aria-labelledby=\"ds-dlg-t\" class=\"ds-dialog\"><div class=\"ds-dialog-head\"><h2 id=\"ds-dlg-t\" class=\"ds-dialog-title\">Excluir atividade?</h2><button type=\"button\" aria-label=\"Fechar\" class=\"ds-dialog-close\"><svg aria-hidden=\"true\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M18 6 6 18\"/><path d=\"m6 6 12 12\"/></svg></button></div><p class=\"ds-dialog-desc\">O histórico desta atividade vai junto.</p></div>",
      "css": ":host{--color-bg:#ffffff;--color-surface:#eef0f6;--color-text:#16181d;--color-text-muted:#50555f;--color-shell:#1b3fbf;--color-on-shell:#ffffff;--color-focus-on-shell:#ffffff;--color-primary:#16181d;--color-on-primary:#ffffff;--color-danger:#b3261e;--color-focus:#16181d;--color-sticker-green:#00a65a;--color-on-sticker:#16181d;--color-sticker-edge:#ffffff;--font-sans:'Barlow',ui-sans-serif,system-ui,sans-serif;--font-display:'Barlow Condensed','Barlow',ui-sans-serif,system-ui,sans-serif;}.ds-dialog{font-family:var(--font-sans);max-width:28rem;background:var(--color-bg);color:var(--color-text);border:2px solid var(--color-text);border-radius:1rem;padding:1.25rem;box-shadow:0 16px 40px -12px rgb(0 0 0 / .4);}.ds-dialog-head{display:flex;align-items:flex-start;justify-content:space-between;gap:.5rem;margin-bottom:.5rem;}.ds-dialog-title{margin:0;padding-top:.5rem;font-family:var(--font-display);font-weight:800;font-size:1.5rem;line-height:1.1;text-transform:uppercase;}.ds-dialog-close{display:inline-flex;min-width:2.75rem;min-height:2.75rem;align-items:center;justify-content:center;border:0;border-radius:.625rem;background:transparent;color:var(--color-text);cursor:pointer;}.ds-dialog-close:hover{background:var(--color-surface);}.ds-dialog-close:focus-visible{outline:3px solid var(--color-focus);outline-offset:2px;}.ds-dialog-desc{margin:0 0 1rem;color:var(--color-text-muted);}"
    }
  ],
  "narrative": {
    "northStar": "Álbum da semana",
